# Remote endpoint that receives scraper metrics
SCRAPER_ENDPOINT=https://example.com/api/orders

# Docker compose service name to inspect (broker, broker2, broker3, ...)
SCRAPER_SERVICE=broker

# Command template to execute for fetching logs. Supported placeholders:
#   {service} -> replaced with SCRAPER_SERVICE
#   {since}   -> replaced with RFC3339Nano timestamp of last processed log
#SCRAPER_LOG_COMMAND=docker compose logs {service} --since {since} --no-color
SCRAPER_LOG_COMMAND="docker compose logs {service} {since} --no-color"

# Working directory used when executing the log command
SCRAPER_WORKDIR=~/boundless

# Path to the persistent state file that stores the last processed timestamp
SCRAPER_STATE_FILE=./scraper_state.json

# Interval between scrapes (Go duration string, e.g. 30s, 5m)
SCRAPER_INTERVAL=60s

# Lookback window used on the first run when no state exists
SCRAPER_INITIAL_LOOKBACK=10m

# Timeout applied to the log command and HTTP POST
SCRAPER_COMMAND_TIMEOUT=60s
SCRAPER_POST_TIMEOUT=15s
